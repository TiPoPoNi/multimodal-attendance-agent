# Multimodal Attendance & Engagement Agent Configuration
# Copy this file to .env and adjust variables as required.

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO

# Storage Paths (relative to project root or absolute paths)
DATABASE_PATH=data/sessions/attendance.db
MODEL_PATH=data/models/blaze_face_short_range.task

# Vision Detection & Tracking Parameters
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=15
DETECTION_CONFIDENCE_THRESHOLD=0.5
TRACK_IOU_THRESHOLD=0.3
TRACK_MAX_INACTIVE_FRAMES=15

# Attendance Rules
MIN_PRESENCE_PERCENTAGE=75.0
MIN_PRESENCE_DURATION_SECONDS=300
MAX_DISAPPEARANCE_SECONDS=30

# Audio Processing Parameters
AUDIO_SAMPLE_RATE=16000
AUDIO_WINDOW_SECONDS=5.0
AUDIO_RMS_THRESHOLD=0.015
AUDIO_ZCR_THRESHOLD=0.05

# Multimodal Fusion Scoring
FUSION_WINDOW_SECONDS=5.0
WEIGHT_VISUAL_PRESENCE=0.4
WEIGHT_AUDIO_ACTIVITY=0.4
WEIGHT_MOVEMENT=0.2

